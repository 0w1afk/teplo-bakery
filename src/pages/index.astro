---
import { Image, getImage } from 'astro:assets'
import QuantityStepper from '../components/QuantityStepper.astro'
import CartDialog from '../components/CartDialog.astro'
import '../styles/cart.css'
import InstagramIcon from '../components/InstagramIcon.astro'
import Base from '../layouts/Base.astro'
import heroDesktop from '../assets/ph-hero-paper.webp'
import craftCrust from '../assets/ph-craft-crust.webp'
import logo from '../assets/logo.png'
import processLeaven from '../assets/ph-process-leaven.webp'
import processMix from '../assets/ph-process-mix.webp'
import processCold from '../assets/ph-process-cold.webp'
import processBake from '../assets/ph-process-bake.webp'
import menuTemny from '../assets/ph-menu-temny.webp'
import menuPervy from '../assets/ph-menu-pervy.webp'
import menuPolba from '../assets/ph-menu-polba.webp'
import menuCelozernovy from '../assets/ph-menu-celozernovy.webp'
import menuZavarnoy from '../assets/ph-menu-zavarnoy.webp'
import menuBaget from '../assets/ph-menu-baget.webp'
import menuCroissant from '../assets/ph-menu-croissant.webp'
import menuPletyonka from '../assets/ph-menu-pletyonka.webp'
import bakerAnna from '../assets/ph-baker-anna.webp'
import bakerDmitry from '../assets/ph-baker-dmitry.webp'
import bakerOlga from '../assets/ph-baker-olga.webp'

const milestones = [
  {
    id: 'ph-process-leaven',
    src: processLeaven,
    day: 1,
    time: '21:00',
    title: 'Закваска',
    text: 'Добавляем в закваску муку и воду. Оставляем до утра.',
  },
  {
    id: 'ph-process-mix',
    src: processMix,
    day: 2,
    time: '10:00',
    title: 'Замес',
    text: 'Замешиваем тесто вручную, пока оно не станет гладким.',
  },
  {
    id: 'ph-process-cold',
    src: processCold,
    day: 2,
    time: '11:00',
    title: 'Расстойка',
    text: 'Ставим тесто в холодильник на 18 часов при +4 °C.',
  },
  {
    id: 'ph-process-bake',
    src: processBake,
    day: 3,
    time: '05:00',
    title: 'Выпечка',
    text: 'Выпекаем хлеб на каменном поду при 250 °C. К открытию первая партия готова.',
  },
]

const menu = [
  { id: 'ph-menu-temny', src: menuTemny, name: '«Тёмный»', desc: 'Ржаной хлеб с солодом и кориандром', price: 520, alt: 'Тёмный ржаной хлеб с кориандром на крафт-бумаге' },
  { id: 'ph-menu-pervy', src: menuPervy, name: '«Хлеб»', desc: 'Пшеничный хлеб на закваске', price: 480, alt: 'Пшеничный хлеб на закваске с крестообразным надрезом' },
  { id: 'ph-menu-polba', src: menuPolba, name: '«Полба»', desc: 'Хлеб из полбы с мёдом', price: 560, alt: 'Овальная буханка из полбы' },
  { id: 'ph-menu-celozernovy', src: menuCelozernovy, name: '«Цельнозерновой»', desc: 'Из свежемолотой пшеницы', price: 540, alt: 'Цельнозерновой хлеб с зёрнами и семенами на корке' },
  { id: 'ph-menu-zavarnoy', src: menuZavarnoy, name: '«Заварной»', desc: 'Бородинский хлеб с тмином', price: 500, alt: 'Буханка заварного хлеба с тёмной коркой' },
  { id: 'ph-menu-baget', src: menuBaget, name: 'Багет «Наутро»', desc: 'За багетом лучше прийти до 9:00.', price: 220, alt: 'Багет с диагональными надрезами на крафт-бумаге' },
  { id: 'ph-menu-croissant', src: menuCroissant, name: 'Круассан', desc: 'На сливочном масле жирностью 82,5 %', price: 280, alt: 'Круассан с тонкими слоями теста' },
  { id: 'ph-menu-pletyonka', src: menuPletyonka, name: '«Плетёнка»', desc: 'С корицей и тростниковым сахаром', price: 320, alt: 'Плетёнка-узел с корицей и сахаром' },
]

const bakers = [
  { id: 'ph-baker-anna', src: bakerAnna, name: 'Анна Соколова', role: 'Работает в утреннюю смену и печёт круассаны.', alt: 'Анна Соколова формует круассаны на деревянном столе, присыпанном мукой' },
  { id: 'ph-baker-dmitry', src: bakerDmitry, name: 'Дмитрий Кузнецов', role: 'Замешивает тесто и следит за расстойкой.', alt: 'Дмитрий Кузнецов поднимает тесто со стола' },
  { id: 'ph-baker-olga', src: bakerOlga, name: 'Ольга Морозова', role: 'Готовит заварное тесто и плетёт булочки с корицей.', alt: 'Ольга Морозова смазывает плетёнку кисточкой' },
]

const heroAlt =
  'Круглый пшеничный хлеб на бумаге, присыпанной мукой'
const heroDesktopImg = await getImage({ src: heroDesktop, widths: [960, 1440, 1920], format: 'webp', alt: heroAlt })
// BASE_URL в этой версии Astro без завершающего слэша: локально «», с base — «/teplo-bakery».
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<Base
  title="«Тепло» — домашняя пекарня в Москве"
  description="Хлеб на закваске, круассаны и плетёнки с корицей. Москва, Ржанская набережная, 4. Открыто ежедневно с 8:00 до 20:00."
>
  <a class="skip-link" href="#main">К содержанию</a>

  <header class="site-header">
    <a class="logo" href="#hero">
      <Image class="bun" src={logo} alt="" width={68} height={50} />
      Тепло
    </a>
    <nav class="site-nav" id="siteNav" aria-label="Разделы">
      <a href="#menu">Выпечка</a>
      <a href="#craft">О хлебе</a>
      <a href="#process">Как печём</a>
      <a href="#baker">Кто печёт</a>
      <a href="#visit">Как найти</a>
    </nav>
    <InstagramIcon />
    <button class="cart-trigger" id="cart-trigger" type="button" title="Корзина" aria-label="Корзина, 0 шт." aria-haspopup="dialog" aria-controls="cart-dialog">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m3 9 2.3 11h13.4L21 9H3Zm4 0 4-6m6 6-4-6M9 12.5l.5 4M15 12.5l-.5 4"/>
      </svg>
      <span id="cart-count">0</span>
    </button>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="siteNav">Меню</button>
  </header>

  <main id="main">
    <!-- Тепло — обложка -->
    <section class="hero" id="hero" data-section="hero" aria-label="Домашняя пекарня «Тепло»">
      <picture class="ph hero-bg" id="ph-hero-paper">
        <source
          media="(max-width: 767px)"
          type="image/avif"
          srcset={`${base}/images/ph-hero-paper-mobile-450.avif 450w, ${base}/images/ph-hero-paper-mobile-768.avif 768w`}
          sizes="100vw"
        />
        <img
          src={heroDesktopImg.src}
          srcset={heroDesktopImg.srcSet.attribute}
          sizes="100vw"
          alt={heroAlt}
          width={1920}
          height={1080}
          loading="eager"
          fetchpriority="high"
        />
      </picture>
      <p class="hero-foot mono-line">Москва · с 2021 года</p>
      <div class="hero-inner">
        <h1 class="hero-word">Тепло</h1>
      </div>
      <div class="hero-bottom">
        <div class="hero-details">
          <p class="hero-sub">Домашняя пекарня.</p>
          <p class="mono-line">Ржанская набережная, 4 · ежедневно с 8:00 до 20:00</p>
        </div>
        <a class="scroll-cue" href="#menu" aria-label="Перейти к разделу «Хлеб и выпечка»">
          <svg width="20" height="12" viewBox="0 0 20 12" fill="none" aria-hidden="true">
            <path d="m2 2 8 8 8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </section>

    <section class="chapter" id="menu" data-section="menu" aria-labelledby="menu-title">
      <h2 id="menu-title">Хлеб и выпечка</h2>

      <p class="menu-note">Хлеб выкладываем к открытию, в 8:00.<br />Круассаны и плетёнки готовы к 8:30.</p>

      <ul class="menu-strip">
        {menu.map((item) => (
          <li class="menu-card">
            <Image
              class="photo square"
              id={item.id}
              src={item.src}
              alt={item.alt}
              width={480}
              height={480}
              loading="lazy"
            />
            <h3>{item.name}</h3>
            <p class="menu-desc">{item.desc}</p>
            <p class="menu-line"><span class="dots"></span><span class="price">{item.price} ₽</span></p>
            <form class="cart-add" data-product={item.id}>
              <QuantityStepper name={item.name} />
              <button type="submit" class="cart-add-button">В корзину</button>
            </form>
          </li>
        ))}
      </ul>

      <a class="cta" href="#visit">Где нас найти</a>
    </section>

    <section class="chapter" id="craft" data-section="craft" aria-labelledby="craft-title">
      <div class="spread">
        <div class="spread-text">
          <h2 id="craft-title">Пшеничный хлеб на закваске</h2>
          <p>Наш пшеничный так и называется — «Хлеб». В нём только мука, вода и соль. Закваску подкармливаем с вечера, а утром замешиваем на ней тесто вручную.</p>
          <p>Тесто подходит в холодильнике 18 часов. За это время у хлеба появляется лёгкая кислинка. Перед выпечкой надрезаем буханку крест-накрест и кладём на горячий камень в печи. Надрез раскрывается, корка подрумянивается, а внутри остаётся мягкий пористый мякиш.</p>
          <p>Свежий ломоть хорош со сливочным маслом. Если хлеб остался на завтра, поджарьте его на сухой сковороде, чтобы края снова хрустели.</p>
        </div>
        <figure class="spread-figure">
          <Image
            class="photo ratio-45"
            id="ph-craft-crust"
            src={craftCrust}
            alt="Корка и пористый мякиш пшеничного хлеба"
            width={800}
            height={1000}
            format="avif"
            loading="lazy"
            fetchpriority="low"
          />
        </figure>
      </div>
    </section>

    <section class="chapter" id="process" data-section="process" aria-labelledby="process-title">
      <h2 id="process-title">Как печём</h2>
      <p class="chapter-intro">Вечером кормим закваску. Через 32 часа ставим хлеб в печь.</p>

      <div class="bench">
        <div class="bench-scale" aria-hidden="true">
          <p class="bench-clock bench-clock-start">21:00 <span class="day">день 1</span></p>
          <div class="bench-axis">
            <span class="bench-current"><span id="benchCurrentTime">21:00</span> <span class="day" id="benchCurrentDay">день 1</span></span>
            <span class="bench-marker"></span>
            <span class="tick t1"></span>
            <span class="tick t2"></span>
            <span class="tick t3"></span>
            <span class="tick t4"></span>
          </div>
          <p class="bench-clock bench-clock-end">05:00 <span class="day">день 3</span></p>
        </div>

        <ol class="timeline">
          {milestones.map((m) => (
            <li class="milestone">
              <Image
                class="photo square mini"
                id={m.id}
                src={m.src}
                alt=""
                width={480}
                height={480}
                loading="lazy"
              />
              <div class="milestone-body">
                <p class="time"><time datetime={m.time}>{m.time}</time> <span class="day">День {m.day}</span></p>
                <h3>{m.title}</h3>
                <p>{m.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="chapter" id="baker" data-section="baker" aria-labelledby="baker-title">
      <h2 id="baker-title">Кто печёт</h2>
      <ul class="baker-grid">
        {bakers.map((b) => (
          <li class="baker-card">
            <Image
              class="photo ratio-45 parallax"
              id={b.id}
              src={b.src}
              alt={b.alt}
              width={800}
              height={1000}
              loading="lazy"
            />
            <h3>{b.name}</h3>
            <p>{b.role}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="chapter" id="visit" data-section="visit" aria-labelledby="visit-title">
      <h2 id="visit-title">Как найти</h2>
      <div class="spread">
        <div class="spread-text">
          <p>Москва, Ржанская набережная, 4.</p>
          <p>Открыто каждый день с 8:00 до 20:00.</p>
          <div class="visit-actions">
            <a class="cta" href="#visit-map" aria-describedby="visit-map-note">Показать на схеме</a>
            <a class="cta cta-ghost" href="tel:+74950000000">Позвонить</a>
          </div>
        </div>
        <figure class="spread-figure" id="visit-map" tabindex="-1">
          <svg class="map" id="ph-map" viewBox="0 0 800 450" role="img" aria-label="Пекарня на схеме Ржанской набережной">
            <rect width="800" height="450" fill="#F6EFE3"></rect>
            <path d="M0 362 C 210 330 430 332 820 384 L 820 450 L 0 450 Z" fill="#BFC9C2"></path>
            <g stroke="#FFF9EE" stroke-width="16" fill="none">
              <path d="M-20 120 H 820"></path>
              <path d="M-20 250 H 820"></path>
              <path d="M140 -20 V 340"></path>
              <path d="M420 -20 V 345"></path>
              <path d="M640 -20 L 720 360"></path>
            </g>
            <g stroke="#D9CCB4" stroke-width="3" fill="none">
              <path d="M-20 185 H 820"></path>
              <path d="M280 -20 V 340"></path>
              <path d="M-20 310 H 560"></path>
            </g>
            <g transform="translate(430 240)">
              <circle r="34" fill="none" stroke="#B4460F" stroke-width="2" opacity="0.4"></circle>
              <circle r="24" fill="#B4460F"></circle>
              <text x="0" y="-48" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="16" letter-spacing="3" fill="#22190F">ТЕПЛО</text>
            </g>
            <text x="468" y="418" font-family="'JetBrains Mono', monospace" font-size="13" letter-spacing="2" fill="#22190F">РЖАНСКАЯ НАБЕРЕЖНАЯ, 4</text>
          </svg>
          <figcaption class="mono-line">Ищите серый дом с белой вывеской на углу.</figcaption>
        </figure>
      </div>
    </section>
  </main>

  <CartDialog products={menu} />

  <footer class="site-footer">
    <p class="mono-line">Домашняя пекарня «Тепло»</p>
    <p class="mono-line" id="visit-map-note">Сайт сделан для портфолио. Адрес и телефон вымышлены.</p>
    <InstagramIcon />
  </footer>

  <script>
    import '../scripts/site-animations'
  </script>
</Base>
