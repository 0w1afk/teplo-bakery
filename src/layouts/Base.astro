---
import '../styles/global.css'
import fontsCss from '../styles/fonts.css?url'

interface Props {
  title: string
  description: string
  lang?: string
}
const { title, description, lang = 'ru' } = Astro.props
const fontsHref = fontsCss
// BASE_URL в этой версии Astro без завершающего слэша: локально «», с base — «/teplo-bakery».
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- base проекта: локально «/favicon.svg», на gussy-pussy.ru «/teplo-bakery/favicon.svg» -->
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <!-- Шрифты грузим ПОСЛЕ window.load: на slow 4G они не делят полосу с LCP-кадром (534KB).
         До свапа — системные fallback-шрифты. -->
    <noscript><link rel="stylesheet" href={fontsHref} /></noscript>
  </head>
  <body>
    <slot />
    <script>
      import { initSmoothScroll } from '../scripts/smooth-scroll'
      initSmoothScroll()
    </script>
    <script is:inline data-fonts-href={fontsHref}>
      window.addEventListener('load', () => {
        const self = document.currentScript ?? document.querySelector('script[data-fonts-href]')
        const link = document.createElement('link')
        link.rel = 'stylesheet'
        link.href = self?.dataset.fontsHref ?? ''
        document.head.appendChild(link)
      })
    </script>
  </body>
</html>
