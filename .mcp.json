{
  "mcpServers": {
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "motion": {
      "type": "http",
      "url": "https://mcp.motion.dev"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "blender": {
      "command": "uvx",
      "args": ["mcp-for-blender@2.2.4"],
      "env": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
        "DISABLE_TELEMETRY": "true"
      }
    },
    "three": {
      "command": "npx",
      "args": ["-y", "mcp-three@0.1.4"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.12.0"]
    }
  }
}
